# Django ResQ Backend Environment Configuration

# Database Engine: 'sqlite' for zero-dependency local dev, or 'mysql' for production/NED course
DB_ENGINE=sqlite

# MySQL settings (used if DB_ENGINE=mysql)
DB_NAME=resq_db
DB_USER=resq
DB_PASSWORD=NewPass123
DB_HOST=127.0.0.1
DB_PORT=3306

# Django settings
DJANGO_SECRET_KEY=resq-dev-secret-key-insecure-only-local
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
